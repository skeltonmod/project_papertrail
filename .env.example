# Flask Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
PORT=5000

# Exchange Selection ('binance' or 'alpaca')
EXCHANGE=binance
USE_TESTNET=True

# Binance Credentials (Get from Binance Testnet)
BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_API_SECRET=your_binance_testnet_secret

# Alpaca Credentials (Get from Alpaca Paper Trading)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_API_SECRET=your_alpaca_paper_secret

# Trading Configuration
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
STRATEGY=moving_average
MA_SHORT_WINDOW=10
MA_LONG_WINDOW=30
TRADE_QUANTITY=0.01
TRADING_INTERVAL=300

# Logging
LOG_LEVEL=INFO